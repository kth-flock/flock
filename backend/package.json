{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "server": "tsx --watch index.ts",
    "test:db:up": "docker compose -f ../docker-compose.yaml -f ../docker-compose.test.yaml up -d --build --force-recreate && docker compose -f ../docker-compose.yaml -f ../docker-compose.test.yaml exec express-api npx prisma migrate deploy",
    "test:db:down": "docker compose -f ../docker-compose.yaml -f ../docker-compose.test.yaml down --remove-orphans",
    "test:api": "newman run api-tests/flock_collection.json --working-dir api-tests",
    "test:api:full": "npm run test:db:up && npm run test:api; code=$?; npm run test:db:down; exit $code",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@flock/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "newman": "^6.2.3",
    "tsx": "^4.23.13"
  }
}
