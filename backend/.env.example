# Copy this file to .env and fill in your local values.
# Never commit the real .env file.

DATABASE_URL="postgresql://username:password@localhost:5432/databasename?schema=public"
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=databasename

# Auth (generate a secret locally, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION="7d"

NODE_ENV="development"

GEOCODING_USER_AGENT="your identification here"

# S3 bucket
AWS_REGION=eu-north-1
S3_BUCKET=flock-dev-s3
AWS_ACCESS_KEY_ID="Your access Key"
AWS_SECRET_ACCESS_KEY="Your secret"