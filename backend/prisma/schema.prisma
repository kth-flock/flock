// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String  
  email           String   @unique
  imageUrl        String?
  pwdHash         String?
  createdAt       DateTime @default(now())

  events    Event[]
  invitees  Invitee[]
  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendRequestee")
  announcements   Announcement[]
  comments    Comment[]
}

model Event {
  id              Int       @id @default(autoincrement())
  createdById     Int         
  title           String
  description     String?
  locationName    String?
  googlePlaceId   String?
  startsAt        DateTime
  endsAt          DateTime?
  imageUrl        String?

  createdBy       User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  invitees        Invitee[]
  announcements   Announcement[]
}

model Invitee {
  eventId         Int
  userId          Int
  rsvp            RSVP   @default(PENDING)
  rsvpComment     String?

  event           Event @relation(fields: [eventId], references: [id])
  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

enum RSVP {
  PENDING
  ACCEPTED
  MAYBE
  DECLINED
}

model Friendship {
  requesterId   Int
  requesteeId   Int
  status        STATUS @default(PENDING)

  requester     User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requestee     User @relation("FriendRequestee", fields: [requesteeId], references: [id], onDelete: Cascade)

  @@id([requesterId, requesteeId])
}

enum STATUS {
  PENDING
  ACCEPTED
}

model Announcement {
  id          Int @id @default(autoincrement())
  eventId     Int
  userId      Int
  content     String
  createdAt   DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id])
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments    Comment[]
}

model Comment {
  id              Int @id @default(autoincrement())
  announcementId  Int
  userId          Int
  content         String
  createdAt       DateTime @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id])
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

}